# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# The compute layer (core/compute) needs NONE of these — Law 1 keeps math offline.

# --- LLM providers (only needed once agents are built, Phase 2+) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Run controls ---
FIRM_AS_OF=              # default as-of date for point-in-time queries, e.g. 2026-07-23
FIRM_RUN_COST_CEILING=   # hard USD ceiling per run; run aborts on breach (see config/models.yaml)
FIRM_CACHE_DIR=.cache    # on-disk LLM response cache (Law 5)
